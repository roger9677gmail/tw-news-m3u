# 瀏覽器與途播會使用這個固定名稱。
APP_NAME=台灣新聞直播 M3U

# 通常留空，程式會依你實際開啟／匯入的網址自動產生播放連結。
# 只有反向代理產生錯誤網址時才固定填入，例如 https://news.example.com
PUBLIC_BASE_URL=

# 建議必填。這是「本服務專用播放權杖」，請換成至少 24 個英數字元。
# 絕對不要填 NAS、Google、GitHub 或任何其他帳號密碼。
ACCESS_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-KEY

# 途播畫質。720 可降低 NAS 上傳流量；可改 480、1080。
MAX_HEIGHT=720

# 直播解析成功後的快取秒數；RESOLVER_TIMEOUT_SECONDS 是單次點台的整體解析上限。
RESOLVER_TTL_SECONDS=900
RESOLVER_FAILURE_TTL_SECONDS=90
RESOLVER_TIMEOUT_SECONDS=75
MAX_RESOLVER_CONCURRENCY=2

# HLS 分段的內部臨時權杖有效時間。
MEDIA_TOKEN_TTL_SECONDS=21600
MAX_TOKEN_ENTRIES=30000
UPSTREAM_TIMEOUT_SECONDS=25
LOG_LEVEL=INFO
TZ=Asia/Taipei

# 卡拉 OK 管理功能。留空就完全停用；正式環境使用私人 Cloud Storage bucket。
GCP_PROJECT_ID=
KARAOKE_BUCKET=
KARAOKE_PREFIX=karaoke
KARAOKE_MAX_UPLOAD_BYTES=629145600
KARAOKE_FFMPEG_TIMEOUT_SECONDS=3300
